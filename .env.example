# Copy to server/.env.local for local API development.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hr_payroll
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGINS=http://localhost:5173
ENABLE_DEMO_SEED=false
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace-with-a-unique-16-character-password
DEMO_HR_EMAIL=hr@example.com
DEMO_HR_PASSWORD=replace-with-a-unique-16-character-password
DEMO_EMPLOYEE_EMAIL=employee@example.com
DEMO_EMPLOYEE_PASSWORD=replace-with-a-unique-16-character-password

# Optional email verification and password-reset delivery.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-smtp-user
EMAIL_PASS=replace-with-your-provider-app-password
EMAIL_FROM=hr@example.com

# Optional client-side API base URL; set in client/.env.local when needed.
VITE_API_URL=http://localhost:5000
